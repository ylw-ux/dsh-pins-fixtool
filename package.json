{
  "name": "dsh-pins",
  "version": "1.0.0",
  "description": "Pin selected passages from a conversation into a right-sidebar note wall, with jump-back to the source message.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs",
    "README.md",
    "README.en.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ylw-ux/dsh-pins.git"
  },
  "homepage": "https://github.com/ylw-ux/dsh-pins#readme",
  "bugs": {
    "url": "https://github.com/ylw-ux/dsh-pins/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "pin",
    "pins",
    "annotation",
    "highlight",
    "notes"
  ],
  "license": "MIT"
}
